{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffeediary",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/coffeediary/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffeediary",
      "database_id": "4808c3a3-f705-4a2e-9ad6-015c96a6927d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // TODO: Web-Client-ID aus der Google Cloud Console eintragen (heute im Supabase-Dashboard hinterlegt)
    "GOOGLE_CLIENT_ID": "REPLACE_ME.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "https://localhost,http://localhost:4200"
  }
  // Secret: npx wrangler secret put SESSION_SECRET
}
